# Qdrant vector database
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=Fap_data_testing
QDRANT_WEB_COLLECTION=flm_fap

# Gemini (optional; enables LLM-based intent analysis and answer synthesis)
GEMINI_API_KEY=your_gemini_api_key

# MySQL
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=your_database_name

# Optional FLM scraper browser profile
EDGE_USER_DATA_DIR=path_to_your_edge_profile
